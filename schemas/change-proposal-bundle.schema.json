{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lexmapa.org/schemas/change-proposal-bundle.schema.json",
  "title": "LexMapa Change Proposal Bundle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "generatedAt",
    "proposals"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "proposals": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/legalChangeProposal"
      }
    }
  },
  "$defs": {
    "jurisdiction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "country",
        "level"
      ],
      "properties": {
        "country": {
          "type": "string",
          "enum": [
            "AR"
          ]
        },
        "level": {
          "type": "string"
        },
        "provinceCode": {
          "type": "string"
        },
        "municipalityName": {
          "type": "string"
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "official"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "sourceUrl": {
          "type": "string"
        },
        "retrievedAt": {
          "type": "string",
          "format": "date-time"
        },
        "official": {
          "type": "boolean"
        }
      }
    },
    "originalSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "label"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "LOADED",
            "PENDING"
          ]
        },
        "label": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "sourceUrl": {
          "type": "string"
        },
        "retrievedAt": {
          "type": "string",
          "format": "date-time"
        },
        "official": {
          "type": "boolean"
        },
        "note": {
          "type": "string"
        }
      }
    },
    "plainLanguageSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "headline",
        "short",
        "keyPoints",
        "whatItMeans",
        "limitations",
        "legalAdviceWarning"
      ],
      "properties": {
        "headline": {
          "type": "string"
        },
        "short": {
          "type": "string"
        },
        "keyPoints": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "whatItMeans": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "legalAdviceWarning": {
          "type": "string"
        }
      }
    },
    "affectedTopic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "summaryPlainLanguage"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "summaryPlainLanguage": {
          "type": "string"
        }
      }
    },
    "affectedGroup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "impactSummary"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "impactSummary": {
          "type": "string"
        }
      }
    },
    "legalVersion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "text",
        "status",
        "source",
        "sourceStatus",
        "originalSource"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "legalItemId": {
          "type": "string"
        },
        "legalItemTitle": {
          "type": "string"
        },
        "provisionId": {
          "type": "string"
        },
        "provisionLabel": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "sourceStatus": {
          "type": "string",
          "enum": [
            "LOADED",
            "PENDING"
          ]
        },
        "originalSource": {
          "$ref": "#/$defs/originalSource"
        }
      }
    },
    "legalDiff": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "proposalId",
        "title",
        "changeType",
        "affectedTopicIds",
        "affectedGroupIds",
        "currentVersion",
        "proposedVersion",
        "explanationPlainLanguage",
        "practicalImpact",
        "impactLevel",
        "source",
        "dataStatus",
        "traceability"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "proposalId": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "changeType": {
          "type": "string",
          "enum": [
            "ADDED",
            "REMOVED",
            "MODIFIED"
          ]
        },
        "affectedTopicIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "affectedGroupIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "currentVersion": {
          "$ref": "#/$defs/legalVersion"
        },
        "proposedVersion": {
          "$ref": "#/$defs/legalVersion"
        },
        "explanationPlainLanguage": {
          "type": "string"
        },
        "practicalImpact": {
          "type": "string"
        },
        "impactLevel": {
          "type": "string",
          "enum": [
            "LOW",
            "MEDIUM",
            "HIGH",
            "UNKNOWN"
          ]
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "dataStatus": {
          "type": "string"
        },
        "traceability": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "currentCitationId": {
              "type": "string"
            },
            "proposedCitationId": {
              "type": "string"
            },
            "notes": {
              "type": "string"
            }
          }
        }
      }
    },
    "legalChangeProposal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "status",
        "jurisdiction",
        "summary",
        "topics",
        "affectedGroups",
        "diffs",
        "queryExamples",
        "source",
        "originalSources",
        "dataStatus",
        "legalAdviceWarning"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "jurisdiction": {
          "$ref": "#/$defs/jurisdiction"
        },
        "typeOfChange": {
          "type": "string"
        },
        "summary": {
          "$ref": "#/$defs/plainLanguageSummary"
        },
        "topics": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/affectedTopic"
          }
        },
        "affectedGroups": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/affectedGroup"
          }
        },
        "diffs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/legalDiff"
          }
        },
        "queryExamples": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "originalSources": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "current",
            "proposed"
          ],
          "properties": {
            "current": {
              "$ref": "#/$defs/originalSource"
            },
            "proposed": {
              "$ref": "#/$defs/originalSource"
            }
          }
        },
        "dataStatus": {
          "type": "string"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "scopeNote": {
          "type": "string"
        },
        "legalAdviceWarning": {
          "type": "string"
        }
      }
    }
  }
}
